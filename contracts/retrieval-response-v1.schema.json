      "required": [
        "operation",
        "task_id",
        "status",
        "work_finished"
      ],
      "additionalProperties": false
    },
    "task_status": {
      "type": "object",
      "properties": {
        "operation": {
          "const": "task_status"
        },
        "task_id": {
          "type": "string",
          "pattern": "^t_[0-9a-f]{64}$"
