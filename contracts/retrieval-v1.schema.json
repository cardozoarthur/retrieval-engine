{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:retrieval-engine:worker-request:1",
  "title": "Retrieval worker requests v1",
  "description": "Local trusted-host pipe. Model configuration and file-root grants are not request fields. Open loads a snapshot; expand never reacquires it.",
  "oneOf": [
    {
      "$ref": "#/$defs/open"
    },
    {
      "$ref": "#/$defs/search"
    },
    {
      "$ref": "#/$defs/expand"
    },
    {
      "$ref": "#/$defs/pack"
    },
    {
      "$ref": "#/$defs/close"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/request_status"
    },
    {
      "$ref": "#/$defs/start_open"
    },
    {
      "$ref": "#/$defs/poll_open"
    },
    {
      "$ref": "#/$defs/peek_open"
    },
    {
      "$ref": "#/$defs/expand_open"
    },
    {
      "$ref": "#/$defs/finish_open"
    },
    {
      "$ref": "#/$defs/cancel_open"
    },
    {
      "$ref": "#/$defs/task_status"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "required": [
        "schema_version",
        "id"
      ]
    },
    "session": {
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "session_id"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Resolved to a canonical file path within a root granted by the host at startup; relative paths use the worker working directory.",
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "open"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "op",
        "source"
      ],
      "unevaluatedProperties": false
    },
    "search": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/session"
        }
      ],
      "properties": {
        "op": {
          "const": "search"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Runtime additionally enforces byte/token budgets; valid shape does not guarantee execution admission."
        },
        "mode": {
          "enum": [
            "literal",
            "bm25",
            "hybrid",
            "hybrid_prefilter"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 10
        }
      },
      "required": [
        "op",
        "query",
        "mode"
      ],
      "unevaluatedProperties": false
    },
    "expand": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/session"
        }
      ],
      "properties": {
        "op": {
          "const": "expand"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "unit": {
          "enum": [
            "characters",
            "words"
          ]
        }
      },
      "required": [
        "op",
        "reference",
        "before",
        "after",
        "unit"
      ],
      "unevaluatedProperties": false
    },
    "pack": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/session"
        }
      ],
      "properties": {
        "op": {
          "const": "pack"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "op",
        "references"
      ],
      "unevaluatedProperties": false
    },
    "close": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/session"
        }
      ],
      "properties": {
        "op": {
          "const": "close"
        }
      },
      "required": [
        "op"
      ],
      "unevaluatedProperties": false
    },
    "request_status": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "request_status"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "op",
        "request_id"
      ],
      "not": {
        "required": [
          "timeout_ms"
        ]
      },
      "unevaluatedProperties": false
    },
    "cancel": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "cancel"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "op",
        "request_id"
      ],
      "not": {
        "required": [
          "timeout_ms"
        ]
      },
      "unevaluatedProperties": false
    },
    "capabilities": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "capabilities"
        }
      },
      "required": [
        "op"
      ],
      "unevaluatedProperties": false
    },
    "start_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "start_open"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "op",
        "source"
      ],
      "unevaluatedProperties": false
    },
    "poll_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "poll_open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "op",
        "task_id"
      ],
      "unevaluatedProperties": false
    },
    "peek_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "peek_open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "op",
        "task_id",
        "query"
      ],
      "unevaluatedProperties": false
    },
    "expand_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "expand_open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "unit": {
          "enum": [
            "characters",
            "words"
          ]
        }
      },
      "required": [
        "op",
        "task_id",
        "reference",
        "before",
        "after",
        "unit"
      ],
      "unevaluatedProperties": false
    },
    "finish_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "finish_open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "op",
        "task_id"
      ],
      "unevaluatedProperties": false
    },
    "cancel_open": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "cancel_open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "op",
        "task_id"
      ],
      "unevaluatedProperties": false,
      "not": {
        "required": [
          "timeout_ms"
        ]
      }
    },
    "task_status": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "op": {
          "const": "task_status"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "op",
        "task_id"
      ],
      "unevaluatedProperties": false,
      "not": {
        "required": [
          "timeout_ms"
        ]
      }
    }
  }
}
